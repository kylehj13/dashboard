{
  "name": "sanbon-morning-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check public/app.js && node --check public/core.js && node --check worker/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "api:dev": "wrangler dev --config worker/wrangler.toml",
    "api:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "fast-xml-parser": "^5.0.0" },
  "devDependencies": { "wrangler": "^4.0.0" }
}
